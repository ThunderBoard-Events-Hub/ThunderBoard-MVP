#Template only — no real secrets in this file, safe to commit.
#Copy to .env for local dev (fill in your own local Postgres URL), OR use this
#as the checklist of variables to set as environment variables directly in
#whatever platform hosts the deployed backend (e.g. Azure App Service ->
#Configuration -> Application settings). Never put real production secrets
#into a committed file.

PORT = 8000
FRONTEND_URL = http://localhost:5173 #the deployed frontend's URL in production; used for CORS
AZURE_DATABASE_URL = postgresql://<user>:<password>@<server-name>.postgres.database.azure.com:5432/postgres?sslmode=verify-full #local Postgres URL for dev, real Azure DB URL in production
NODE_ENV = development #"production" turns on strict SSL for the DB connection (see src/config/database.js)

AZURE_STORAGE_URL = DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_EVENTS_CONTAINER_NAME = event-images
AZURE_STORAGE_ORGANIZATION_CONTAINER_NAME = organization-logos

AUTH0_DOMAIN = <your-tenant>.auth0.com
AUTH0_AUDIENCE = https://thunderboard-api
#AUTH0_AUDIENCE must match the "Identifier" of the API you create in the Auth0 dashboard
#(Applications > APIs > Create API) — it doesn't need to be a real, reachable URL.
#Same domain/audience are used in both dev and production — they're not secrets.

#Comma-separated Auth0 user IDs (the "sub" claim, e.g. "auth0|abc123,auth0|def456")
#allowed to act as admins — approve/decline organizations, manage tags. Find a
#user's ID in the Auth0 dashboard under Users.
ADMIN_AUTH0_IDS = auth0|abc123
